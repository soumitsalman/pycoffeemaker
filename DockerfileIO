# Slim IO image for collector, porter, and remote OpenAI-compatible NLP.
# Not for local GPU models (use DockerfileGPU).


# Final stage
FROM python:3.13-slim-bookworm

# Set the working directory
WORKDIR /worker

COPY . .
RUN pip install --no-cache -r requirements-io.txt

RUN mkdir -p .cache

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive \
    COLLECTOR_SOURCES=/worker/factory/feeds.yaml 

RUN chmod +x run_pipeline.sh

# Exec form so `docker run ... --collector 64 --porter 512` is forwarded
ENTRYPOINT ["/worker/run_pipeline.sh"]
