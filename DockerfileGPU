FROM runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404

USER root
WORKDIR /worker

# s5cmd: latest GitHub Linux-64bit release (needed for --clustering clscache)
RUN python3 - <<'PY'
import io, json, os, tarfile, urllib.request

api = "https://api.github.com/repos/peak/s5cmd/releases/latest"
with urllib.request.urlopen(api) as r:
    rel = json.load(r)
url = next(
    a["browser_download_url"]
    for a in rel["assets"]
    if a["name"].endswith("_Linux-64bit.tar.gz")
)
dest = "/usr/local/bin"
os.makedirs(dest, exist_ok=True)
with urllib.request.urlopen(url) as r:
    tar = tarfile.open(fileobj=io.BytesIO(r.read()), mode="r:gz")
    member = next(m for m in tar.getmembers() if os.path.basename(m.name) == "s5cmd")
    member.name = "s5cmd"
    try:
        tar.extract(member, dest, filter="fully_trusted")
    except TypeError:
        tar.extract(member, dest)
os.chmod(os.path.join(dest, "s5cmd"), 0o755)
PY

COPY requirements-gpu.txt /tmp/requirements-gpu.txt
RUN python3 -m pip install --no-cache-dir --upgrade-strategy only-if-needed -r /tmp/requirements-gpu.txt \
    && rm -f /tmp/requirements-gpu.txt

ENV HF_HOME=/worker/.models \
    HF_HUB_CACHE=/worker/.models \
    HUGGINGFACE_HUB_CACHE=/worker/.models \
    TRANSFORMERS_CACHE=/worker/.models \
    SENTENCE_TRANSFORMERS_HOME=/worker/.models \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    TOKENIZERS_PARALLELISM=false \
    VLLM_ENABLE_V1_MULTIPROCESSING=0 \
    S5CMD_BIN=/usr/local/bin/s5cmd \
    COLLECTOR_SOURCES=/worker/factory/feeds.yaml

RUN python3 - <<'PY'
from huggingface_hub import snapshot_download

# Indexer weights only. DIGESTOR and CONSOLIDATOR vLLM models stay lazy.
# Paths match run_pipeline.sh EMBEDDER_PATH and EXTRACTOR_PATH.
for repo in (
    "codefuse-ai/F2LLM-v2-80M",
    "fastino/gliner2.5-multi-v1",
):
    snapshot_download(repo_id=repo)
PY

COPY . .
RUN chmod +x /worker/run_pipeline.sh && mkdir -p /worker/.cache

# Exec form so a RunPod container command is argv for the script:
#   --embedder 128 --extractor 32
ENTRYPOINT ["/worker/run_pipeline.sh"]
