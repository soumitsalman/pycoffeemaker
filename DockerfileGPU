# syntax=docker/dockerfile:1.7
# Analyzer / GPU LLM image. CUDA 12.4 PyTorch base; vLLM, ST, and GLiNER are
# installed explicitly to avoid the vLLM base image's startup path on Salad.
# ENTRYPOINT forwards `docker run ... --embedder 64 --clustering 128` to run_pipeline.sh.
# Salad Container Engine supports AMD64 images only. Force the platform here so
# builds from an ARM workstation cannot publish an image that fails before PID 1.
# This pinned AMD64 CUDA 12.4 runtime matches vLLM 0.8.5's Torch 2.6.0
# requirement and supports Salad's RTX 3090 / RTX A5000 pool.
FROM --platform=linux/amd64 pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime

USER root
WORKDIR /worker

# s5cmd: latest GitHub Linux-64bit release (needed for --clustering clscache)
RUN python3 - <<'PY'
import io, json, os, tarfile, urllib.request

api = "https://api.github.com/repos/peak/s5cmd/releases/latest"
with urllib.request.urlopen(api) as r:
    rel = json.load(r)
url = next(
    a["browser_download_url"]
    for a in rel["assets"]
    if a["name"].endswith("_Linux-64bit.tar.gz")
)
dest = "/usr/local/bin"
os.makedirs(dest, exist_ok=True)
with urllib.request.urlopen(url) as r:
    tar = tarfile.open(fileobj=io.BytesIO(r.read()), mode="r:gz")
    member = next(m for m in tar.getmembers() if os.path.basename(m.name) == "s5cmd")
    member.name = "s5cmd"
    try:
        tar.extract(member, dest, filter="fully_trusted")
    except TypeError:
        tar.extract(member, dest)
os.chmod(os.path.join(dest, "s5cmd"), 0o755)
PY

COPY requirements-gpu.txt /tmp/requirements-gpu.txt
RUN python3 -m pip install --no-cache-dir --upgrade-strategy only-if-needed -r /tmp/requirements-gpu.txt \
    && rm -f /tmp/requirements-gpu.txt

ENV HF_HOME=/worker/.models \
    HF_HUB_CACHE=/worker/.models \
    HUGGINGFACE_HUB_CACHE=/worker/.models \
    TRANSFORMERS_CACHE=/worker/.models \
    SENTENCE_TRANSFORMERS_HOME=/worker/.models \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    TOKENIZERS_PARALLELISM=false \
    VLLM_ENABLE_V1_MULTIPROCESSING=0 \
    S5CMD_BIN=/usr/local/bin/s5cmd \
    COLLECTOR_SOURCES=/worker/factory/feeds.yaml

RUN python3 - <<'PY'
from huggingface_hub import snapshot_download

# Preload only the indexer models. The large DIGESTOR and CONSOLIDATOR vLLM
# models are downloaded lazily when those modes are explicitly invoked.
for repo in (
    "codefuse-ai/F2LLM-v2-80M",
    "knowledgator/modern-gliner-bi-base-v1.0",
    # GLiNER resolves this label-encoder tokenizer at runtime; cache it too so
    # the startup probe and offline Salad workers never need Hugging Face.
    "BAAI/bge-small-en-v1.5",
):
    snapshot_download(repo_id=repo)
PY

COPY . .
RUN chmod +x /worker/run_pipeline.sh && mkdir -p /worker/.cache

# Temporary Salad startup probe. Keep the complete runtime and baked indexer
# models intact while proving that PID 1, Python libraries, and local model files
# can start on a Salad node. The container-group command is intentionally ignored
# until this diagnostic image has reached Running and emitted its probe logs.
ENTRYPOINT ["/bin/bash", "-c", "echo '[salad-probe] PID 1 started'; python3 - <<'PY'\nimport torch\nimport vllm\nfrom sentence_transformers import SentenceTransformer\nfrom gliner import GLiNER\n\nprint(f'[salad-probe] torch={torch.__version__} vllm={vllm.__version__} cuda_available={torch.cuda.is_available()}')\nSentenceTransformer('codefuse-ai/F2LLM-v2-80M', local_files_only=True, device='cpu')\nprint('[salad-probe] embedder model loaded from local cache')\nGLiNER.from_pretrained('knowledgator/modern-gliner-bi-base-v1.0', local_files_only=True)\nprint('[salad-probe] extractor model loaded from local cache')\nPY\nprobe_status=$?\nif [ \"$probe_status\" -ne 0 ]; then echo \"[salad-probe] library/model probe failed (status $probe_status); keeping container alive\"; fi\necho '[salad-probe] complete; waiting for inspection'; exec sleep infinity"]
